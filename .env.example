SF_USER=your_email@example.com
SF_PASSWORD=your_snowflake_password
SF_ACCOUNT=abc12345.us-east-1
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=UHC_TIC
SF_SCHEMA=STAGING

# Storage mode: LOCAL (default) or S3
STORAGE_MODE=LOCAL

# AWS S3 (only needed if STORAGE_MODE=S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-uhc-data-bucket
S3_PREFIX=parquet/

# Snowflake S3 role ARN (only needed if STORAGE_MODE=S3)
# Format: arn:aws:iam::123456789012:role/snowflake-role
SF_S3_ROLE=your_snowflake_s3_role_arn
